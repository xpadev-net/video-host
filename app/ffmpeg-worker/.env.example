# FFmpeg worker configuration. Local MinIO credentials are for development only.
NODE_ENV=development
CALLBACK_SECRET=dev-callback-secret
BACKEND_CALLBACK_URL=http://localhost:3001/api/v4/callback/encode-complete
REDIS_URL=redis://localhost:6379
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=
REDIS_SENTINEL_PASSWORD=
S3_TMP_BUCKET=video-tmp
S3_PROD_BUCKET=video-prod
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
VOD_BASE_URL=http://localhost:3002
POLL_INTERVAL_MS=5000
TEMP_DIR=/tmp/ffmpeg-worker
MIN_DISK_SPACE_GB=1
JOB_TIMEOUT_SECONDS=7200
FFMPEG_THREADS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_SERVICE_NAME=video-host-ffmpeg-worker
