{
  "name": "@video-host/frontend",
  "version": "0.0.59",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit --pretty --noErrorTruncation --project tsconfig.json",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test": "pnpm test:unit && pnpm test:ui",
    "test:proxy": "node --test tests/proxy-smoke.test.mjs",
    "test:runtime-env": "node --test tests/placeholder-runtime.test.mjs",
    "test:all": "pnpm test && pnpm test:proxy && pnpm test:runtime-env"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "event-source-plus": "^0.1.15",
    "hls.js": "^1.7.3",
    "hono": "^4.13.13",
    "jotai": "^3.0.1",
    "lucide-react": "^1.61.0",
    "nitro": "^3.0.260610-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.12.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@video-host/backend": "workspace:*",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "nprogress": "^0.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.2"
  }
}
