# Browser API endpoint. Leave empty to use the same-origin development proxy.
VITE_API_ENDPOINT=

# Server-only backend URL used by Vite/Nitro. Never add a VITE_ prefix.
API_UPSTREAM_URL=http://127.0.0.1:3001

# Site Configuration
# Name displayed in browser title and throughout the site
VITE_SITE_NAME=Video Host

# Features Configuration
# Enable/disable Niconico-style overlay comments
VITE_ENABLE_COMMENTS=true

# User Registration Configuration
# Require signup code for new user registration
# Set to "true" to require signup code, "false" or omit to make it optional
VITE_REQUIRE_SIGNUP_CODE=false
