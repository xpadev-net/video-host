generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
  LIMITED
}

enum Role {
  USER
  ADMIN
}

enum MovieStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum InvitationTargetType {
  MOVIE
  PROFILE
}

model User {
  id                String        @id @default(uuid())
  name              String
  username          String        @unique
  accountId         String
  account           AuthUser      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  avatarUrl         String?       @db.Text
  visibility        Visibility    @default(PUBLIC)
  series            Series[]
  movies            Movie[]
  externalId        String?       @unique @db.VarChar(512)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  playlists         Playlist[]
  viewableMovies    MovieViewer[]
  profileViewers    ProfileViewer[] @relation("ProfileViewer_profile")
  viewableProfiles  ProfileViewer[] @relation("ProfileViewer_user")
  sentInvitations   AccessInvitation[]

  @@index([accountId, createdAt])
  @@index([visibility])
}

// Common account: authentication is optional; roles apply to all owned profiles.
// User rows are profiles; credentials and sessions belong to this account.
model AuthUser {
  id                 String        @id
  name               String
  email              String?       @unique @db.VarChar(320)
  emailVerified      Boolean       @default(false)
  image              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sessions           AuthSession[]
  accounts           AuthAccount[]
  role               Role          @default(USER)
  profiles           User[]
  receivedInvitations AccessInvitation[]
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAccount {
  id                    String    @id
  accountId             String    @db.VarChar(512)
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
}

model Series {
  id          String     @id @default(uuid())
  title       String     @db.VarChar(512)
  description String?    @db.Text
  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId    String
  movies      Movie[]
  visibility  Visibility @default(PUBLIC)
  externalId  String?    @unique @db.VarChar(512)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([visibility, updatedAt])
  @@index([authorId, updatedAt])
}

model Playlist {
  id          String            @id @default(uuid())
  title       String            @db.VarChar(512)
  description String?           @db.Text
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId    String
  visibility  Visibility        @default(PUBLIC)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  movies      MovieOnPlaylist[]

  @@index([visibility, updatedAt])
  @@index([authorId, updatedAt])
}

model MovieViewer {
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([movieId, userId])
}

model ProfileViewer {
  profile   User     @relation("ProfileViewer_profile", fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  user      User     @relation("ProfileViewer_user", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([profileId, userId])
  @@index([userId])
}

// A pending grant of viewer access on a target (a LIMITED movie or a
// non-public profile). The inviter shares the target with an account; the
// invitee accepts and chooses which of their profiles receives the access.
model AccessInvitation {
  id                String               @id @default(uuid())
  inviterId         String
  inviter           User                 @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeAuthUserId String
  invitee           AuthUser             @relation(fields: [inviteeAuthUserId], references: [id], onDelete: Cascade)
  targetType        InvitationTargetType
  targetId          String
  status            InvitationStatus     @default(PENDING)
  grantedProfileId  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([inviteeAuthUserId, status])
  @@index([inviterId])
  @@index([targetType, targetId])
}

model MovieOnPlaylist {
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId    String
  order      Int

  @@id([playlistId, movieId])
}

model Movie {
  id           String            @id @default(uuid())
  title        String            @db.VarChar(512)
  description  String?           @db.Text
  author       User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId     String
  series       Series?           @relation(fields: [seriesId], references: [id])
  seriesId     String?
  duration     Int               @default(0)
  thumbnailUrl String?           @db.Text
  visibility   Visibility        @default(PUBLIC)
  externalId   String?           @unique @db.VarChar(512)
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  variants     MovieVariant[]
  playlists    MovieOnPlaylist[]
  viewers      MovieViewer[]

  @@index([visibility, createdAt])
  @@index([seriesId, order, createdAt])
}

model MovieVariant {
  id         String      @id @default(uuid())
  movie      Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId    String
  variantId  String
  contentUrl String      @db.Text
  s3Key      String?     @db.VarChar(512)
  status     MovieStatus @default(READY)
  externalId String?     @unique @db.VarChar(512)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([movieId, variantId])
  @@index([movieId, status])
}
