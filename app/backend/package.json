{
  "name": "@video-host/backend",
  "version": "0.0.42",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "prisma",
    "start.mjs",
    "start.sh"
  ],
  "types": "./dist/types.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm prisma:generate && tsc && tsc-alias",
    "run": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit --skipLibCheck --pretty --noErrorTruncation --skipDefaultLibCheck --project tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:schema-check": "test -n \"$SHADOW_DATABASE_URL\" || { echo 'SHADOW_DATABASE_URL is required' >&2; exit 1; }; prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@video-host/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.7.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.7",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "mysql2": "^3.24.6",
    "prisma": "6.19.3",
    "redis": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
