{
  "name": "@video-host/backend",
  "version": "0.0.36",
  "types": "./dist/types.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "run": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit --skipLibCheck --pretty --noErrorTruncation --skipDefaultLibCheck --project tsconfig.json",
    "prepare": "pnpm prisma generate || true",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.952.0",
    "@aws-sdk/s3-request-presigner": "^3.952.0",
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "6.19.0",
    "dotenv": "^17.2.3",
    "hono": "^4.12.18",
    "prisma": "^6.19.1",
    "redis": "^5.10.0",
    "zod": "^4.2.1",
    "better-auth": "1.7.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@vitest/coverage-v8": "^4.0.16",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.21.0",
    "vitest": "^4.0.16"
  }
}
