# Combined reference for environment managers that inject values into workspace commands.
# Package-local dotenv files are loaded from each app directory; see README.md.
NODE_ENV=development
DATABASE_URL=mysql://video_host:video_host@127.0.0.1:3306/video_host
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=video_host
MYSQL_USER=video_host
MYSQL_PASSWORD=video_host
BETTER_AUTH_SECRET=development-only-better-auth-secret-do-not-deploy
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
AUTH_TRUSTED_PROXY_CIDRS=
CALLBACK_SECRET=dev-callback-secret
VOD_INTERNAL_SECRET=dev-vod-internal-secret
# Set to true only while rolling out playback tokens (accepts unsigned VOD mapping requests)
VOD_ALLOW_UNSIGNED=false
PORT=3001
SIGNUP_ENABLED=true
SIGNUP_CODE=
PASSWORD_AUTH_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_DISPLAY_NAME=SSO
OIDC_AUTO_PROVISION=true
OIDC_ALLOW_HTTP=false
CORS_ORIGIN=
PUBLIC_ENDPOINTS=
S3_TMP_BUCKET=video-tmp
# Maximum accepted upload size in bytes (default 5 GiB)
MAX_UPLOAD_BYTES=5368709120
S3_PROD_BUCKET=video-prod
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=secret
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
REDIS_URL=redis://localhost:6379
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=
REDIS_SENTINEL_PASSWORD=
VOD_BASE_URL=http://localhost:3002
BACKEND_BASE_URL=http://localhost:3001
POLL_INTERVAL_MS=5000
TEMP_DIR=/tmp/ffmpeg-worker
MIN_DISK_SPACE_GB=1
JOB_TIMEOUT_SECONDS=7200
FFMPEG_THREADS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_SERVICE_NAME=video-host
API_UPSTREAM_URL=http://127.0.0.1:3001
VITE_API_ENDPOINT=
VITE_SITE_NAME=Video Host
