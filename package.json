{
  "name": "video-host",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm -F @video-host/frontend dev",
    "dev:backend": "pnpm -F @video-host/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "typecheck": "pnpm -F @video-host/backend build && pnpm -r --workspace-concurrency=1 typecheck",
    "prisma:generate": "pnpm -r prisma:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "lefthook": "^2.2.2"
  },
  "packageManager": "pnpm@10.25.0"
}
