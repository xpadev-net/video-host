{
  "name": "video-host",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm -F @video-host/frontend dev",
    "dev:backend": "pnpm -F @video-host/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "prepare": "lefthook install",
    "prisma:generate": "pnpm -r prisma:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "lefthook": "^2.0.12",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "lefthook",
      "prisma",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
