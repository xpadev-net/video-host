{
  "name": "video-host",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm -F @video-host/frontend dev",
    "dev:backend": "pnpm -F @video-host/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r --parallel typecheck",
    "prepare": "lefthook install",
    "prisma:generate": "pnpm -r prisma:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "lefthook": "^2.1.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "lefthook",
      "prisma",
      "@parcel/watcher",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "fast-xml-parser@>=5.0.9 <=5.3.3": ">=5.3.4",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "fast-xml-parser@>=5.0.0 <5.3.5": ">=5.3.5",
      "fast-xml-parser@>=5.0.0 <5.3.6": ">=5.3.6",
      "hono@<4.12.4": ">=4.12.4",
      "fast-xml-parser@>=5.0.0 <5.3.8": ">=5.3.8",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "hono@<4.12.7": ">=4.12.7",
      "fast-xml-parser@>=5.0.0 <5.5.6": ">=5.5.6",
      "effect@<3.20.0": ">=3.20.0",
      "fast-xml-parser@>=4.0.0-beta.3 <=5.5.6": ">=5.5.7",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4"
    }
  }
}
